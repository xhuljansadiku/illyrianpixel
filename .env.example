# Copy to .env.local for local development, and add the same variables in your
# hosting provider's project settings. All of them are optional for local work.

# Public base URL — used for canonical URLs, hreflang, sitemap, Open Graph and JSON-LD.
# On Vercel it falls back to the project's production domain automatically.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.se

# Contact form delivery via Resend (https://resend.com). Server-side only — never
# exposed to the browser. Without all three, inquiries are logged to the terminal
# in development, and the API answers 503 (form shows an error) in production.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hello@your-domain.se
CONTACT_FROM_EMAIL="Nordic Pixel <hello@your-domain.se>"
