{
  "name": "nordicpixel",
  "version": "0.1.0",
  "private": true,
  "description": "Nordic Pixel — Scandinavian full-service digital agency website (Swedish + English).",
  "engines": {
    "node": ">=22"
  },
  "browserslist": [
    "chrome >= 111",
    "edge >= 111",
    "firefox >= 115",
    "safari >= 16.4",
    "ios_saf >= 16.4"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/generate-icons.mjs",
    "check:static": "node scripts/check-static.mjs",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build && npm run check:static"
  },
  "dependencies": {
    "next": "^15.5.26",
    "next-intl": "^4.13.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.11",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^8.57.0",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "typescript": "^5.5.3",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "postcss": "$postcss",
    "nanoid": "^3.3.19"
  }
}
